<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>openidea.smoke</groupId>
    <artifactId>reactor</artifactId>
    <version>1</version>
  </parent>
  <groupId>openidea.smoke.beta</groupId>
  <artifactId>shared</artifactId>
  <dependencies>
    <dependency>
      <groupId>openidea.smoke.alpha</groupId>
      <artifactId>shared</artifactId>
      <version>1</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <reportsDirectory>${project.build.directory}/unit-xml</reportsDirectory>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>integration-tests</id>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
            <configuration>
              <reportsDirectory>${project.build.directory}/integration-xml</reportsDirectory>
              <promoteUserPropertiesToSystemProperties>false</promoteUserPropertiesToSystemProperties>
              <systemPropertyVariables>
                <fixture.it>configured</fixture.it>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
